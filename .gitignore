# OpenTofu working directories
**/.terraform/*

# OpenTofu state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Plan files
*.tfplan

# Crash logs
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Environment/secrets
.env
.env.*
*.secret
secrets/
*.key
*.pem

# Local credential files
*pve-token*

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
